# Proves pam4_map / pam4_demap against the locked level table.
# Run from this folder:  sby -f pam4.sby
[options]
mode prove
depth 1

[engines]
smtbmc

[script]
read -formal pam4_map.v pam4_demap.v pam4_spec_checker.v pam4_formal_top.v
prep -top pam4_formal_top

[files]
../rtl/pam4_map.v
../rtl/pam4_demap.v
pam4_spec_checker.v
pam4_formal_top.v
