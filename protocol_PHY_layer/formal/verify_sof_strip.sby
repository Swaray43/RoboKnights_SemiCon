# Proves the reset/FSM-safety properties in flit_sof_strip (`ifdef FORMAL block).
# Replaces verify_reset.sby, which pointed at a missing module_with_properties.sv.
# Run from this folder:  sby -f verify_sof_strip.sby
[tasks]
word
flit

[options]
mode prove
depth 20
multiclock off

[engines]
smtbmc boolector

[script]
read -formal flit_sof_strip.v
word: chparam -set PAYLOAD_CYCLES 8 flit_sof_strip
flit: chparam -set PAYLOAD_CYCLES 64 -set RESYNC_MIDFLIT 0 flit_sof_strip
prep -top flit_sof_strip

[files]
../rtl/flit_sof_strip.v
